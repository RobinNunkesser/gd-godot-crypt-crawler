; Engine configuration file.
; Crypt Crawler: Dungeon Graph & Roguelike (Godot 4)
; Didactic Showcase: Topological Graphs, VGLC Parsing & Lock-and-Key DAG Solvability

config_version=5

[application]

config/name="Crypt Crawler: Dungeon Graph & Roguelike"
config/description="Topological Dungeon Crawler in Godot 4: VGLC Zelda Graph Parsing, Procedural BSP Generation & Lock-and-Key Solvability"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]

environment/defaults/default_clear_color=Color(0.05, 0.06, 0.1, 1)
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method.web="gl_compatibility"
